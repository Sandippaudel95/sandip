# Copy to .env.local and fill in. .env* is gitignored; never commit real values.

# Postgres. Neon or Vercel Postgres; use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# openssl rand -base64 32
AUTH_SECRET=""

# Admin sign-in. The password is stored as a BCRYPT HASH, never plaintext:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_EMAIL="sandip.paudel@lbc.edu.np"
ADMIN_PASSWORD_HASH=""

# Email. Optional: without it, bookings still save and the dashboard flags
# that the client was not notified.
RESEND_API_KEY=""
FROM_EMAIL="Sandip Paudel <bookings@sandipaudel.com.np>"

NEXT_PUBLIC_SITE_URL="https://sandipaudel.com.np"
